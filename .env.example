# 游戏王 AI 助手 - 环境变量配置示例
# 复制本文件为 .env，并填入你的真实 Key

# ============ LLM Provider（二选一） ============
# 视觉模型（百炼实际开通名；OCR 版擅长抽字、理解尚可）
# 申请地址：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY=

# 模型名（如已更换成通用 vl 模型，把 qwen-vl-ocr-* 改成对应名字）
VISION_MODEL=qwen-vl-ocr-2025-11-20
DECISION_MODEL=qwen-max

# 备选：智谱 GLM-4V-Plus（OpenAI 兼容协议）
# 申请地址：https://bigmodel.cn/
GLM_API_KEY=

# 备选：OpenAI / 其他 OpenAI 兼容服务（如用 OpenRouter / 一键 API 等）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============ 行为开关 ============
# Provider 选择：dashscope | glm | openai
LLM_PROVIDER=dashscope

# 截屏频率（秒）— 主分析循环
SCREENSHOT_INTERVAL=1.0

# 用户 ✗ 忽略时的"高密度观察"采样频率（秒）
# 0.2 表示 5 FPS，足以抓到快速操作；mss 截屏本身廉价，
# LLM 调用有 hash 去重，不会因此爆量。
SCREENSHOT_INTERVAL_NEGLECT=0.2

# 是否启用决策记忆（True/False）
ENABLE_MEMORY=True

# 相似历史检索条数
MEMORY_TOP_K=3

# 桌宠闲聊模式:
#   static = 内置 12 句循环（零成本，推荐）
#   llm    = LLM 实时生成（自然多样，但需要在百炼开通至少一个轻量 chat 模型）
CHITCHAT_MODE=static

# 战斗中（analyzing 模式）是否额外生成「吐槽」气泡
COMBAT_CHAT=False
